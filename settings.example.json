{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          { "type": "command", "command": "python \"C:/Users/YOU/.claude/hooks/rehydrate.py\"", "timeout": 30 }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          { "type": "command", "command": "python \"C:/Users/YOU/.claude/widget/precompact_signal.py\"", "timeout": 5 }
        ]
      }
    ]
  },
  "statusLine": { "type": "command", "command": "python \"C:/Users/YOU/.claude/statusline.py\"" }
}
